{
  "id": "BRISNIK-HR-B4",
  "label": "Brisnik: SSRI, SNRI or mirtazapine with at least two blood pressure lowering medicines at age 65 or over",
  "family": "BRISNIK",
  "title": "SSRI, SNRI or mirtazapine with two or more other blood pressure lowering medicines, age 65 or over",
  "statement": "Prescribed SSRI, SNRI, or mirtazapine - and the patient is aged ≥ 65 years and co-prescribed ≥ 2 further drugs with blood pressure lowering effect (e.g., α-blockers, β-blockers, nitrates, SGLT inhibitors, levodopa, antipsychotics)",
  "statement_origin": "published",
  "source": {
    "document": "Brisnik V, et al. Deprescribing of antidepressants: indicators of high-risk and overprescribing. BMC Med 2024;22:193, Tables 3-4",
