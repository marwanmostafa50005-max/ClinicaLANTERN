  "id": "BRISNIK-HR-C1",
  "label": "Brisnik: antidepressant with a fall-risk medicine at age 65 or over",
  "family": "BRISNIK",
  "title": "Any antidepressant with another fall-risk medicine, age 65 or over",
  "statement": "Prescribed any antidepressant - and the patient is aged ≥ 65 years and co-prescribed ≥ 1 further fall risk-increasing drug[c]",
  "statement_origin": "published",
