{
  "id": "PROMPT-DU-1",
  "label": "PROMPT DU-1: two medicines of one class",
  "family": "PROMPT",
  "title": "Two or more medicines from the same class",
  "statement": "The use of two or more drugs from the same pharmacological class should be avoided, unless used for additive effects in line with current clinical guidelines.",
  "statement_origin": "published",
  "source": {
    "document": "Cooper JA, et al. The development of the PROMPT criteria. BMC Health Serv Res 2014;14:484, Table 4",
    "citation": "Cooper JA, Ryan C, Smith SM, et al. The development of the PROMPT (PRescribing Optimally in Middle-aged People's Treatments) criteria. BMC Health Serv Res 2014;14:484",
