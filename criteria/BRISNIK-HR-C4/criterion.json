  "needs_facts": [
    {
      "kind": "condition",
      "what": "History of stroke",
      "meets": "A stroke had occurred before or during the period of combined prescribing.",
      "options": [
        {
          "words": "Stroke before or during combined treatment",
          "effect": "meets"
        },
        {
          "words": "No stroke had occurred by the end of combined treatment",
          "effect": "does_not_meet"
        },
        {
          "words": "Not known",
          "effect": "unknown"
        }
      ]
    }
  ],
  "rule_for_models": "Look for a Group A antidepressant and a different fall-risk medicine from Group B or a second fall-risk antidepressant from Group A, with overlapping supplies or supply dates within 60 days. Cite both medicines and the history if a stroke had occurred by the time of combined prescribing, even if an earlier entry denied stroke. For that pair, report no finding if no stroke had yet occurred, and a possible finding if the history or timing is unclear, asking whether a stroke had occurred by then.",
  "cannot_be_seen": "When the stroke happened, how well the person has recovered, and the doses really taken. Medicines bought without a prescription or supplied by a hospital or another pharmacy.",
  "ask_the_gp": "If stroke history is unclear, could you confirm whether the patient has had a stroke? If so, could you review the antidepressant, the other medicine that increases falls risk and the patient's risk of falling?",
  "urgency": "routine",
  "draft": true,
  "signed_by_clinical_reviewer": null
}
