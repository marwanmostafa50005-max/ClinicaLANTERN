{
  "id": "BRISNIK-HR-C4",
  "label": "Brisnik: antidepressant after a stroke with a fall-risk medicine",
  "family": "BRISNIK",
  "title": "Any antidepressant in a person with a history of stroke who also takes another fall-risk medicine",
  "statement": "Prescribed any antidepressant - and the patient has a history of stroke and co-prescribed ≥ 1 further fall-risk-increasing drug",
  "statement_origin": "published",
  "source": {
    "document": "Brisnik V, et al. Deprescribing of antidepressants: indicators of high-risk and overprescribing. BMC Med 2024;22:193, Tables 3-4",
