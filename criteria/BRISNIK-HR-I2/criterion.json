{
  "id": "BRISNIK-HR-I2",
  "label": "Brisnik: SSRI or SNRI plus two sodium-lowering medicines",
  "family": "BRISNIK",
  "title": "SSRI or SNRI with two other sodium-lowering medicines in an older person",
  "statement": "Prescribed SSRI or SNRI - and the patient is aged ≥ 65 years and co-prescribed ≥ 2 further drugs known to cause hyponatremia (e.g., (thiazide) diuretics, antipsychotics, anticonvulsants, proton pump inhibitors)[c]",
  "statement_origin": "published",
  "source": {
    "document": "Brisnik V, et al. Deprescribing of antidepressants: indicators of high-risk and overprescribing. BMC Med 2024;22:193, Tables 3-4",
